# Package that carries the claim module (bump to the new published-at after
# every `sui client upgrade`; see move/ssu_open_claim/Published.toml).
VITE_CLAIM_PACKAGE_ID=0x37bf31ff7ce1e5ddc91b038153f0f3488ca4ab311a0d972a305c9f9bcccc46e3
# Original (v1) package id — never changes across upgrades. The on-chain
# `extension` field records the ClaimAuth witness under this defining id.
VITE_CLAIM_AUTH_PACKAGE_ID=0x4defff877661097a0fdfac67a87dc6e23f37b1664cff81bb166037a34930f610
# World package for the target tenant (testnet_stillness cycle 6).
VITE_WORLD_PACKAGE_ID=0x8b8a46ed766fa1358ce7c5c51f6a164b13d627a63e45343f69ed0ba0446c1aa1
# Same value under the name @evefrontier/dapp-kit requires (it throws without it).
VITE_EVE_WORLD_PACKAGE_ID=0x8b8a46ed766fa1358ce7c5c51f6a164b13d627a63e45343f69ed0ba0446c1aa1
VITE_CLAIM_MODULE=claim
# Optional: world API host used for type_id -> item name lookups.
# Defaults to the stillness cycle host; change on a new cycle.
#VITE_WORLD_API_HOST=world-api-stillness.live.pub.evefrontier.com
