# Package that carries the claim module (bump to the new published-at after
# every `sui client upgrade`; see move/ssu_open_claim/Published.toml).
VITE_CLAIM_PACKAGE_ID=0x679214b103db42dd074bb454914e61b18ac881b9a9e9f121a9b318dd61c56594
# Original (v1) package id — never changes across upgrades. The on-chain
# `extension` field records the ClaimAuth witness under this defining id.
VITE_CLAIM_AUTH_PACKAGE_ID=0x679214b103db42dd074bb454914e61b18ac881b9a9e9f121a9b318dd61c56594
# World package for the target tenant (testnet_stillness cycle 7).
VITE_WORLD_PACKAGE_ID=0x7be18d6294e533bedd9a5d70a96ce8d9d4b87a7c74188ba65d3fe966bbed9d92
# Same value under the name @evefrontier/dapp-kit requires (it throws without it).
VITE_EVE_WORLD_PACKAGE_ID=0x7be18d6294e533bedd9a5d70a96ce8d9d4b87a7c74188ba65d3fe966bbed9d92
VITE_CLAIM_MODULE=claim
# Optional: world API host used as the FALLBACK for type_id -> item name
# lookups (src/data/typeNames.json is consulted first). Defaults to the
# stillness cycle host; change on a new cycle.
#VITE_WORLD_API_HOST=world-api-stillness.live.pub.evefrontier.com
